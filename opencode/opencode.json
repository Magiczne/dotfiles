{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
        "disabled": true
      },
      "context7": {
        "type": "local",
        "command": ["npx", "-y", "@upstash/context7-mcp"],
        "disabled": false
      },
      "nuxt": {
        "type": "remote",
        "url": "https://nuxt.com/mcp"
        "disabled": false
      }
      "nuxt-ui": {
        "type": "remote",
        "url": "https://ui.nuxt.com/mcp",
        "disabled": false
      }
    }
  },
  "plugins": ["@dietrichgebert/ponytail"]
}
