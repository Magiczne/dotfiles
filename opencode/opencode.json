{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "chrome-devtools": {
            "command": "npx",
            "args": [
                "chrome-devtools-mcp@latest"
            ]
        },
        "context7": {
            "type": "local",
            "command": ["npx", "-y", "@upstash/context7-mcp"],
            "enabled": true
        },
        "primevue": {
            "type": "local",
            "command": ["npx", "-y", "@primevue/mcp"],
            "enabled": true
        }
    }
}
