{
    "$schema": "https://opencode.ai/config.json",
    "experimental": {
        "openTelemetry": false
    },
    "lsp": true,
    "mcp": {
        "chrome-devtools": {
            "type": "local",
            "args": ["npx", "-y", "chrome-devtools-mcp@latest"],
            "enabled": true
        },
        "context7": {
            "type": "local",
            "command": ["npx", "-y", "@upstash/context7-mcp"],
            "enabled": true
        },
        "nuxt": {
            "type": "remote",
            "url": "https://nuxt.com/mcp"
        }
    },
    "plugin": ["@dietrichgebert/ponytail"]
}
